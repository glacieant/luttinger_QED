        RowBox[{"{", 
         RowBox[{
          RowBox[{"MomProd", "[", 
           RowBox[{"d", ",", "q", ",", "q"}], "]"}], "->", " ", 
          RowBox[{"q", "^", "2"}]}], "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{"NX", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"UnitArea", "[", "4", "]"}], "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "^", "4"}]}], " ", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"q", "^", "3"}], " ", 
          RowBox[{"FullSimplify", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Contract", "[", "MX", "]"}], "//.", "NewDRule"}], ",", 
            RowBox[{"q", ">", "0"}]}], "]"}]}], ",", "q"}], "]"}]}]}], ";", 
     "\n", 
     RowBox[{"OX", "=", 
      RowBox[{"NX", "/.", 
       RowBox[{"{", 
        RowBox[{"q", "->", " ", "\[CapitalLambda]"}], "}"}]}]}], ";", "\n", 
     RowBox[{"PX", "=", 
      RowBox[{"NX", "/.", 
       RowBox[{"{", 
        RowBox[{"q", "->", " ", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"-", "r"}], "]"}], "\[CapitalLambda]"}]}], "}"}]}]}], ";", 
     "\n", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{
         RowBox[{"OX", "-", "PX"}], ",", 
