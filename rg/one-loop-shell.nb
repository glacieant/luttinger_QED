Cell["There is a solution here!", "Subsection",ExpressionUUID->"e594dcd5-6e0d-4867-b324-82fa4d7994dc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Nfx", "=", "16"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"XYL", "=", 
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"ZCPBeta3", "[", 
        RowBox[{"g3", ",", "Nfx"}], "]"}], "==", "0"}], "&&", 
      RowBox[{"g3", ">", "0"}]}], ",", "g3", ",", "Reals"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ITX", "=", 
   RowBox[{"Length", "[", "XYL", "]"}]}], ";"}], "\n", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"g1s", "=", 
     RowBox[{"0", "/.", 
      RowBox[{"XYL", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}]}], ";", "\n", 
    RowBox[{"Print", "[", "\"\<Luttinger-Zeeman (LZ) fixed point\>\"", "]"}], 
    ";", "\n", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\!\\(\\*SuperscriptBox[\\(\[Alpha]\\), \\(*\\)]\\) = \>\"",
       "<>", 
      RowBox[{"ToString", "[", "g1s", "]"}]}], "]"}], ";", "\n", 
    RowBox[{"g2s", "=", 
     RowBox[{
      RowBox[{"g2Sol", "[", 
       RowBox[{"0", ",", "g3", ",", "Nfx"}], "]"}], "/.", 
      RowBox[{"XYL", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}]}], ";", "\n", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\!\\(\\*SuperscriptBox[\\(K\\), \\(*\\)]\\) = \>\"", "<>", 
      
      RowBox[{"ToString", "[", "g2s", "]"}]}], "]"}], ";", "\n", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\!\\(\\*SuperscriptBox[\\(\[Rho]\\), \\(*\\)]\\) = \>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"g3", "/.", 
        RowBox[{"XYL", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}], ";", "\n", 
    RowBox[{"g4s", "=", 
     RowBox[{
      RowBox[{"g4Sol", "[", 
       RowBox[{"0", ",", "g3", ",", "Nfx"}], "]"}], "/.", 
      RowBox[{"XYL", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}]}], ";", "\n", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\!\\(\\*SuperscriptBox[\\(\[Sigma]\\), \\(*\\)]\\) = \>\"",
       "<>", 
      RowBox[{"ToString", "[", "g4s", "]"}]}], "]"}], ";", "\n", 
    RowBox[{"g3s", "=", 
     RowBox[{"g3", "/.", 
      RowBox[{"XYL", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}]}], ";", "\n", 
    RowBox[{"McX", "=", 
     RowBox[{"(", 
      RowBox[{"{", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Beta1", "[", 
             RowBox[{
             "g1", ",", "g2", ",", "g3", ",", "g4", ",", "Nfx", ",", 
              "\[Epsilon]"}], "]"}], ",", "g1"}], "]"}], ",", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Beta1", "[", 
             RowBox[{
             "g1", ",", "g2", ",", "g3", ",", "g4", ",", "Nfx", ",", 
              "\[Epsilon]"}], "]"}], ",", "g2"}], "]"}], ",", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Beta1", "[", 
             RowBox[{
             "g1", ",", "g2", ",", "g3", ",", "g4", ",", "Nfx", ",", 
              "\[Epsilon]"}], "]"}], ",", "g3"}], "]"}], ",", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Beta1", "[", 
             RowBox[{
             "g1", ",", "g2", ",", "g3", ",", "g4", ",", "Nfx", ",", 
              "\[Epsilon]"}], "]"}], ",", "g4"}], "]"}]}], "}"}], ",", "\n", 
        " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Beta2", "[", 
             RowBox[{
             "g1", ",", "g2", ",", "g3", ",", "g4", ",", "Nfx", ",", 
              "\[Epsilon]"}], "]"}], ",", "g1"}], "]"}], ",", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Beta2", "[", 
             RowBox[{
             "g1", ",", "g2", ",", "g3", ",", "g4", ",", "Nfx", ",", 
              "\[Epsilon]"}], "]"}], ",", "g2"}], "]"}], ",", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Beta2", "[", 
