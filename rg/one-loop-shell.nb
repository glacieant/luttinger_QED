     RowBox[{
      RowBox[{"RuleDfunc", "[", "t_", "]"}], ":=", " ", 
      RowBox[{
       RowBox[{"Momenta", "[", 
        RowBox[{"D", ",", 
         RowBox[{"Lfunc", "[", 
          RowBox[{
           RowBox[{"MomVector", "[", 
            RowBox[{"d", ",", "p"}], "]"}], ",", 
           RowBox[{"MomVector", "[", 
            RowBox[{"d", ",", "p"}], "]"}]}], "]"}], ",", "t"}], "]"}], ":>", 
       
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"d", "/", 
           RowBox[{"(", 
            RowBox[{"2", 
             RowBox[{"(", 
              RowBox[{"d", "-", "1"}], ")"}]}], ")"}]}], "]"}]}], " ", 
        RowBox[{"Momenta", "[", 
         RowBox[{"D", ",", 
          RowBox[{"dfunc", "[", "p", "]"}], ",", "t"}], "]"}]}]}]}], ";", 
     "\n", 
     RowBox[{
