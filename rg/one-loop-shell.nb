Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"UnitArea", "[", "d", "]"}], "/", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", "\[Pi]"}], ")"}], "^", "d"}]}], " ", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"q", "^", 
      RowBox[{"(", 
       RowBox[{"d", "-", "1"}], ")"}]}], " ", 
     RowBox[{
      RowBox[{"q", "^", "n"}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"q", "^", "2"}], "+", "X"}], ")"}], "^", "l"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"q", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"X", ">", "0"}], ",", 
       RowBox[{"Y", ">", "0"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"l", ",", "n", ",", "d"}], "}"}], "\[Element]", "Reals"}], ",", 
       RowBox[{"0", "<=", "l", "<=", " ", 
        RowBox[{"2", "n"}]}]}], "}"}]}]}], "]"}]}]], "Input",ExpressionUUID->\
"851365c6-ac9d-4586-9f24-383efb48b85a"],

Cell[BoxData[
 TemplateBox[{
   FractionBox[
    RowBox[{
      SuperscriptBox["2", 
       RowBox[{"-", "d"}]], " ", 
      SuperscriptBox["\[Pi]", 
       RowBox[{
         RowBox[{"-", "d"}], "/", "2"}]], " ", 
      SuperscriptBox["X", 
       RowBox[{"3", "+", 
         FractionBox["d", "2"], "-", "l"}]], " ", 
      RowBox[{"Gamma", "[", 
