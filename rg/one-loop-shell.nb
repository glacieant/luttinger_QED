Cell[BoxData[
 RowBox[{
  RowBox[{"WickProd", "[", 
   RowBox[{"d_", ",", "indices_", ",", "P_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"l", "=", 
       RowBox[{"Length", "[", "indices", "]"}]}], ",", "intindices", ",", "i",
       ",", "ix", ",", "f", ",", "g", ",", "J1", ",", "J2", ",", "J3"}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"intindices", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"ix", "[", "i", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "l"}], "}"}]}], "]"}]}], ";", 
     RowBox[{
      RowBox[{"f", "[", "s_", "]"}], ":=", 
      RowBox[{
       RowBox[{"Kronecker", "[", 
        RowBox[{"d", ",", 
         RowBox[{"s", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"s", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], 
       RowBox[{
        RowBox[{"Signature", "[", "s", "]"}], "^", "P"}]}]}], ";", 
     RowBox[{
      RowBox[{"g", "[", "S_", "]"}], ":=", 
      RowBox[{"Apply", "[", 
       RowBox[{"Times", ",", 
        RowBox[{"Map", "[", 
         RowBox[{"f", ",", 
          RowBox[{"Partition", "[", 
           RowBox[{"S", ",", "2"}], "]"}]}], "]"}]}], "]"}]}], ";", 
     RowBox[{"J1", "=", 
      RowBox[{"Map", "[", 
       RowBox[{"g", ",", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Permutations", "[", "intindices", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Signature", "[", "#", "]"}], "==", "1"}], "&"}]}], 
         "]"}]}], "]"}]}], ";", 
     RowBox[{"J2", "=", 
      RowBox[{"Map", "[", 
       RowBox[{"g", ",", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Permutations", "[", "intindices", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Signature", "[", "#", "]"}], "==", 
            RowBox[{"-", "1"}]}], "&"}]}], "]"}]}], "]"}]}], ";", "\n", 
     RowBox[{"J3", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"l", "/", "2"}], ")"}], "!"}], " ", 
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"l", "/", "2"}], ")"}]}]}], ")"}]}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Total", "[", "J1", "]"}], "+", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", "P"}], " ", 
           RowBox[{"Total", "[", "J2", "]"}]}]}], ")"}]}], "//", 
       "FullSimplify"}]}], ";", 
     RowBox[{"J3", "//.", 
      RowBox[{"Thread", "[", 
       RowBox[{"intindices", "->", " ", "indices"}], "]"}]}]}]}], 
   "]"}]}]], "Input",ExpressionUUID->"2c0677b5-b0a1-48fb-b524-0b1dbb72782a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Isotropic", "[", 
   RowBox[{"d_", ",", "q_", ",", "indices_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"l", "=", 
       RowBox[{"Length", "[", "indices", "]"}]}], ",", "norm"}], "}"}], ",", 
    RowBox[{
     RowBox[{"norm", "=", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Pochhammer", "[", 
          RowBox[{
           RowBox[{"d", "/", "2"}], ",", 
           RowBox[{"l", "/", "2"}]}], "]"}], 
         RowBox[{"2", "^", 
          RowBox[{"(", 
           RowBox[{"l", "/", "2"}], ")"}]}]}], ")"}]}]}], ";", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"EvenQ", "[", "l", "]"}], ",", 
        RowBox[{"norm", " ", 
         RowBox[{
          RowBox[{"MomProd", "[", 
           RowBox[{"d", ",", "q", ",", "q"}], "]"}], "^", 
          RowBox[{"(", 
           RowBox[{"l", "/", "2"}], ")"}]}], " ", 
         RowBox[{"WickProd", "[", 
          RowBox[{"d", ",", "indices", ",", "0"}], "]"}]}], ",", "0"}], "]"}],
       "//", "FullSimplify"}]}]}], "]"}]}]], "Input",ExpressionUUID->\
"af34e4c1-119c-4ada-b2a3-a96c0d69da3d"],

