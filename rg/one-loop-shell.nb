             "g1", ",", "g2", ",", "g3", ",", "g4", ",", "Nfx", ",", 
              "\[Epsilon]"}], "]"}], ",", "g3"}], "]"}], ",", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Beta2", "[", 
             RowBox[{
             "g1", ",", "g2", ",", "g3", ",", "g4", ",", "Nfx", ",", 
              "\[Epsilon]"}], "]"}], ",", "g4"}], "]"}]}], "}"}], ",", "\n", 
        " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Beta3", "[", 
             RowBox[{
             "g1", ",", "g2", ",", "g3", ",", "g4", ",", "Nfx", ",", 
              "\[Epsilon]"}], "]"}], ",", "g1"}], "]"}], ",", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Beta3", "[", 
             RowBox[{
             "g1", ",", "g2", ",", "g3", ",", "g4", ",", "Nfx", ",", 
              "\[Epsilon]"}], "]"}], ",", "g2"}], "]"}], ",", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Beta3", "[", 
             RowBox[{
             "g1", ",", "g2", ",", "g3", ",", "g4", ",", "Nfx", ",", 
              "\[Epsilon]"}], "]"}], ",", "g3"}], "]"}], ",", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Beta3", "[", 
             RowBox[{
             "g1", ",", "g2", ",", "g3", ",", "g4", ",", "Nfx", ",", 
              "\[Epsilon]"}], "]"}], ",", "g4"}], "]"}]}], "}"}], ",", "\n", 
        " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Beta4", "[", 
             RowBox[{
             "g1", ",", "g2", ",", "g3", ",", "g4", ",", "Nfx", ",", 
              "\[Epsilon]"}], "]"}], ",", "g1"}], "]"}], ",", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Beta4", "[", 
             RowBox[{
             "g1", ",", "g2", ",", "g3", ",", "g4", ",", "Nfx", ",", 
              "\[Epsilon]"}], "]"}], ",", "g2"}], "]"}], ",", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Beta4", "[", 
             RowBox[{
             "g1", ",", "g2", ",", "g3", ",", "g4", ",", "Nfx", ",", 
              "\[Epsilon]"}], "]"}], ",", "g3"}], "]"}], ",", " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"Beta4", "[", 
             RowBox[{
             "g1", ",", "g2", ",", "g3", ",", "g4", ",", "Nfx", ",", 
              "\[Epsilon]"}], "]"}], ",", "g4"}], "]"}]}], "}"}]}], "\n", 
       "}"}], ")"}]}], ";", "\n", 
    RowBox[{"BcX", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"McX", "/.", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"XYL", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"g4", "->", 
           RowBox[{"g4s", " ", "\[Epsilon]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"g2", "->", 
           RowBox[{"g2s", " ", "\[Epsilon]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"g1", "->", 
           RowBox[{"g1s", " ", "\[Epsilon]"}]}], "}"}]}], "]"}]}], "]"}]}], ";",
     "\n", 
    RowBox[{"AcX", "=", 
     RowBox[{"Normal", "[", 
      RowBox[{"Series", "[", 
       RowBox[{"BcX", ",", 
        RowBox[{"{", 
         RowBox[{"\[Epsilon]", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}]}], 
    ";", "\n", 
    RowBox[{
    "Print", "[", "\"\<\\!\\(\\*SubscriptBox[\\(M\\), \\(LZ\\)]\\) = \>\"", 
     "]"}], ";", "\n", 
    RowBox[{"Print", "[", 
     RowBox[{"AcX", "//", "MatrixForm"}], "]"}], ";", "\n", 
    RowBox[{
    "Print", "[", "\"\<\\!\\(\\*SubscriptBox[\\(\[Lambda]\\), \\(LZ\\)]\\) = \
\>\"", "]"}], ";", "\n", 
    RowBox[{"Print", "[", 
     RowBox[{"Eigenvalues", "[", "AcX", "]"}], "]"}], ";", "\n", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g1x", ",", "g2x", ",", "g3x", ",", "g4x"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{"g1s", ",", "g2s", ",", "g3s", ",", "g4s"}], "}"}]}], ";", "\n", 
    RowBox[{"range2", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.1"}], ",", "0.1"}], "}"}]}], ";", "\n", 
    RowBox[{"range1", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.1"}], ",", "0.1"}], "}"}]}], ";", "\n", 
    RowBox[{"xfg", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"StreamPlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
