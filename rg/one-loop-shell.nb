         RowBox[{"SpaceIdx", "[", 
          RowBox[{"d", ",", "i_"}], "]"}]}], "]"}], ":>", "0"}]}], ";", "\n", 
     
     RowBox[{"NewDRule", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
