 RowBox[{
  RowBox[{"PhSE1", "=", 
   RowBox[{"-", 
    RowBox[{"TR", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"QEDVertex1", "[", 
        RowBox[{"d", ",", 
         RowBox[{"Q", "+", "P"}], ",", 
         RowBox[{"-", "P"}], ",", 
         RowBox[{"-", "Q"}], ",", "L", ",", "i"}], "]"}], " ", ".", " ", 
       RowBox[{"FeProp", "[", 
