       RowBox[{"FeProp", "[", 
        RowBox[{"d", ",", "Q", ",", "L"}], "]"}]}], ",", 
      RowBox[{"Contract", "->", " ", "False"}]}], "]"}]}]}], ";"}], "\n", 
