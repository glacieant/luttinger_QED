          RowBox[{"arr", "[", 
           RowBox[{"q", ",", 
            RowBox[{"Join", "[", 
             RowBox[{"s1", ",", "s2"}], "]"}]}], "]"}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"arr", "[", 
            RowBox[{"q", ",", "s_"}], "]"}], "^", "l_"}], ":>", " ", 
