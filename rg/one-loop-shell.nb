           RowBox[{"p", ",", "s", ",", "l"}], "]"}]}]}], "}"}]}]}], ";", "\n", 
     RowBox[{"LX", "=", 
      RowBox[{"KX", "//.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"arr", "[", 
          RowBox[{"q", ",", "s_"}], "]"}], ":>", " ", 
         RowBox[{"Isotropic", "[", 
          RowBox[{"d", ",", "q", ",", "s"}], "]"}]}], "}"}]}]}], ";", "\n", 
     RowBox[{"MX", "=", 
      RowBox[{"LX", "//.", 
