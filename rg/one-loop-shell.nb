          " ", 
          RowBox[{"Kronecker", "[", 
           RowBox[{"d", ",", "i", ",", "j"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"L", "[", 
           RowBox[{"i_", ",", "i_"}], "]"}], ":>", " ", "0"}], ",", 
         RowBox[{
          RowBox[{"L", "[", 
           RowBox[{"i_", ",", "j_"}], "]"}], ":>", " ", 
          RowBox[{"Lfunc", "[", 
           RowBox[{
            RowBox[{"SpaceIdx", "[", 
             RowBox[{"d", ",", "i"}], "]"}], ",", 
            RowBox[{"SpaceIdx", "[", 
             RowBox[{"d", ",", "j"}], "]"}]}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"arr", "[", 
           RowBox[{"p", ",", "s_"}], "]"}], ":>", " ", 
