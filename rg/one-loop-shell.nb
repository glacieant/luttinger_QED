           RowBox[{
            RowBox[{"Kronecker", "[", 
             RowBox[{"d", ",", "i", ",", "l"}], "]"}], 
            RowBox[{"Kronecker", "[", 
             RowBox[{"d", ",", "j", ",", "k"}], "]"}]}], "-", 
           RowBox[{
            RowBox[{"2", "/", "d"}], " ", 
            RowBox[{"Kronecker", "[", 
             RowBox[{"d", ",", "i", ",", "j"}], "]"}], 
            RowBox[{"Kronecker", "[", 
             RowBox[{"d", ",", "k", ",", "l"}], "]"}]}]}]}]}], "}"}]}]}], ";",
      "\n", 
     RowBox[{"BX", "=", " ", 
      RowBox[{"Contract", "[", 
       RowBox[{"ExpandAll2", "[", 
        RowBox[{"AX", "//.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Kronecker", "[", 
             RowBox[{"d", ",", "i_", ",", "j_"}], "]"}], "^", "n_"}], ":>", 
           "  ", 
           RowBox[{"Kronecker", "[", 
            RowBox[{"d", ",", "i", ",", "j"}], "]"}]}], "}"}]}], "]"}], 
       "]"}]}], ";", "\n", 
     RowBox[{"DX", "=", 
      RowBox[{
       RowBox[{"ExpandScalarProduct", "[", "BX", "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p0", "->", 
          RowBox[{
           RowBox[{"s", "^", "2"}], " ", "p0"}]}], ",", 
         RowBox[{
          RowBox[{"MomVector", "[", 
           RowBox[{"d", ",", "p"}], "]"}], "->", " ", 
          RowBox[{"s", " ", 
           RowBox[{"MomVector", "[", 
            RowBox[{"d", ",", "p"}], "]"}]}]}]}], "}"}]}]}], ";", "\n", 
     RowBox[{"FX", "=", 
      RowBox[{"SeriesCoefficient", "[", 
       RowBox[{"DX", ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "0", ",", "pwr"}], "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"RuleFunc", "[", "t_", "]"}], ":=", 
      RowBox[{
       RowBox[{"Momenta", "[", 
        RowBox[{"d", ",", "p", ",", "t"}], "]"}], ":>", " ", 
       RowBox[{"arr", "[", 
        RowBox[{"p", ",", 
         RowBox[{"{", "t", "}"}]}], "]"}]}]}], ";", "\n", 
     RowBox[{
      RowBox[{"Rulefunc2", "[", 
       RowBox[{"x_", ",", "y_", ",", "l_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"arr", "[", 
        RowBox[{"p", ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"a", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "l"}], "}"}]}], "]"}]}], "]"}], 
       RowBox[{"arr", "[", 
        RowBox[{"q", ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"a", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "l"}], "}"}]}], "]"}]}], "]"}]}]}], ";",
      "\n", 
     RowBox[{"NewRule", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Momenta", "[", 
            RowBox[{"d", ",", "q", ",", "t_"}], "]"}], ":>", " ", 
           RowBox[{"arr", "[", 
            RowBox[{"q", ",", 
             RowBox[{"{", "t", "}"}]}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"MomProd", "[", 
            RowBox[{"d", ",", "p", ",", "q"}], "]"}], ":>", " ", 
           RowBox[{
            RowBox[{"arr", "[", 
             RowBox[{"p", ",", 
              RowBox[{"{", "a1", "}"}]}], "]"}], 
            RowBox[{"arr", "[", 
             RowBox[{"q", ",", 
              RowBox[{"{", "a1", "}"}]}], "]"}]}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"MomProd", "[", 
             RowBox[{"d", ",", "p", ",", "q"}], "]"}], "^", "l_"}], ":>", " ", 
           RowBox[{"Rulefunc2", "[", 
            RowBox[{"p", ",", "q", ",", "l"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"RuleFunc", "[", "t", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "extInd"}], "}"}]}], "]"}]}], "]"}]}], ";", "\n", 
     RowBox[{"JX", "=", 
      RowBox[{
       RowBox[{"ExpandAll2", "[", "FX", "]"}], "//.", "NewRule"}]}], ";", 
     "\n", 
     RowBox[{
      RowBox[{"arrsplit", "[", 
       RowBox[{"x_", ",", "s_"}], "]"}], ":=", 
      RowBox[{"Apply", "[", 
       RowBox[{"Times", ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Momenta", "[", 
           RowBox[{"d", ",", "x", ",", "i"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "s"}], "}"}]}], "]"}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"arrjoin", "[", 
       RowBox[{"x_", ",", "s_", ",", "l_"}], "]"}], ":=", 
      RowBox[{"arr", "[", 
       RowBox[{"x", ",", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{"s", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "l"}], "}"}]}], "]"}], "]"}]}], 
       "]"}]}], ";", "\n", 
     RowBox[{"KX", "=", 
