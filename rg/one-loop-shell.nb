          RowBox[{"r", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}], "]"}]}]}],
    "]"}]}]], "Input",ExpressionUUID->"dbfd37bd-d6c5-45dd-9bc8-4dd515a664db"],

