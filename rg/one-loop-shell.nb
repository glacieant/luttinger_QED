    RowBox[{
      RowBox[{"Gamma", "[", 
        FractionBox["d", "2"], "]"}], " ", 
      RowBox[{"Gamma", "[", "l", "]"}]}]], 
   RowBox[{
     RowBox[{"l", ">", "0"}], "&&", 
     RowBox[{
       RowBox[{"6", "+", "d"}], "<", 
