Cell[BoxData[
 RowBox[{
  RowBox[{"intcont", "[", 
   RowBox[{"d_", ",", "q_", ",", "indices_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"l", "=", 
       RowBox[{"Length", "[", "indices", "]"}]}], ",", "norm"}], "}"}], ",", 
    RowBox[{
     RowBox[{"norm", "=", 
      FractionBox["1", 
       RowBox[{
        RowBox[{"Pochhammer", "[", 
         RowBox[{
          FractionBox["d", "2"], ",", 
          FractionBox["l", "2"]}], "]"}], 
        SuperscriptBox["2", 
         FractionBox["l", "2"]]}]]}], ";", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"EvenQ", "[", "l", "]"}], ",", 
        RowBox[{"norm", " ", 
         SuperscriptBox[
          RowBox[{"Pair", "[", 
           RowBox[{
