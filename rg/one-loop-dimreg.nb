  FractionBox[
   RowBox[{"\[CapitalOmega]", "[", "d", "]"}], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"2", "\[Pi]"}], ")"}], "d"]], 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox["q", 
