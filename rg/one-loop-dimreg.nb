             RowBox[{"q", ",", "d"}], "]"}], ",", 
            RowBox[{"Momentum", "[", 
             RowBox[{"q", ",", "d"}], "]"}]}], "]"}], 
          FractionBox["l", "2"]], 
         RowBox[{"wick", "[", 
          RowBox[{"d", ",", "indices", ",", "0"}], "]"}]}], ",", "0"}], "]"}],
