Cell[TextData[{
 "If you compare with Moon et al., they have z = 2 - 8 u/15. Our g1 is their \
u. So it matches perfectly. Their critical ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["u", "*"], "=", 
    RowBox[{"15", 
     RowBox[{"\[Epsilon]", "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"30", "  ", 
          SubscriptBox["N", "f"]}], "+", "8"}], ")"}], " ", "~", "15"}]}], 
     RowBox[{"\[Epsilon]", "/", "38"}]}]}], TraditionalForm]],ExpressionUUID->
  "d7193cf8-3a63-4854-abd7-15027b93c923"],
 " is the same as our estimation.  So we have the correct critical point."
}], "Subsubsection",
 InitializationCell->True,
 CellChangeTimes->{{3.847469541677006*^9, 3.847469548426001*^9}, {
  3.84746963604322*^9, 3.847469642973118*^9}, {3.847469805667617*^9, 
  3.8474699092010202`*^9}, {3.8474699801079817`*^9, 3.847470004079597*^9}, {
  3.8474701397126226`*^9, 3.8474701692936573`*^9}, {3.8474701999849453`*^9, 
  3.8474702416170883`*^9}, {3.847470274122942*^9, 
  3.847470281517057*^9}},ExpressionUUID->"769a196a-4d9f-4272-bfd3-\
c4fbc2ae3a26"],

Cell[CellGroupData[{

