Cell[TextData[{
 "The inverse photon velocity coupling ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "3"], TraditionalForm]],ExpressionUUID->
  "d496d11f-a758-4af4-bd1f-63dca07aea47"],
 " is relevant and starts to flow! But this can in turn make the Pauli term \
flow as well. The photon acceleration coupling ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "2"], TraditionalForm]],ExpressionUUID->
  "96156c32-77ec-405b-8ed0-700c8872337c"],
 "has a large negative dimension for small ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "4"], TraditionalForm]],ExpressionUUID->
  "39c3980e-d1eb-4862-99d0-0cd9e5b001dc"],
 "at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "2"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "2c9c119b-9035-4290-abcf-655df998f2fd"],
 ". To reduce our problem we shall work in the limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["g", "2"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "c9d0cb96-c77b-4403-aa34-5f2ecc3c91da"],
 "."
}], "Subsubsection",
 CellChangeTimes->{{3.852246860065545*^9, 3.852246884704001*^9}, {
  3.852250114304014*^9, 3.8522501297347527`*^9}, {3.8522502459783382`*^9, 
  3.852250255254407*^9}, {3.8522504075617332`*^9, 3.8522504194261103`*^9}, {
  3.85225048759081*^9, 3.852250513534059*^9}, {3.85225062656214*^9, 
  3.852250652692274*^9}, {3.852250693420491*^9, 3.8522508149512777`*^9}, {
  3.852261052799693*^9, 
  3.852261064335063*^9}},ExpressionUUID->"9e4c12e0-b59d-4dc6-b177-\
745815c62225"],

Cell[CellGroupData[{

Cell[TextData[{
 "For ",
