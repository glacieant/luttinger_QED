  FormBox[
   RowBox[{"\[Epsilon]", " ", "=", " ", "2"}], TraditionalForm]],
  ExpressionUUID->"3abf814c-e2fd-4e9e-b1fb-889917771f4f"],
 " , on the other hand,"
}], "Subsubsection",
