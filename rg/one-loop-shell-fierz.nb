Cell[TextData[{
 "Beyond this ",
 Cell[BoxData[
  FormBox["\[Epsilon]", TraditionalForm]],ExpressionUUID->
  "19bbdf7a-e536-445d-8760-b3a0d57f8db1"],
 ", the LAB fixed point is not stable. But for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", " ", "=", " ", "1"}], TraditionalForm]],
  ExpressionUUID->"e18958e6-fedd-4031-a2ca-ead0248d3969"],
 " we find,"
}], "Subsubsection",
