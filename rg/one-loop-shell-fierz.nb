Cell[TextData[{
 "There appears to be a critical ",
 Cell[BoxData[
  FormBox["\[Epsilon]", TraditionalForm]],ExpressionUUID->
  "5e020d1b-e24a-4dc7-82a9-1ca8abb80299"],
 " for the relevance of the photon velocity term, and instability of the LAB \
fixed point"
}], "Subsubsection",
