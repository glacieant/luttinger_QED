Cell[BoxData[
 RowBox[{
  RowBox[{"wick", "[", 
   RowBox[{"d_", ",", "indices_", ",", "P_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"l", "=", 
       RowBox[{"Length", "[", "indices", "]"}]}], ",", "intindices", ",", "i",
       ",", "ix", ",", "f", ",", "g", ",", "J1", ",", "J2", ",", "J3"}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{"intindices", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"ix", "[", "i", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "l"}], "}"}]}], "]"}]}], ";", 
     RowBox[{
      RowBox[{"f", "[", "s_", "]"}], ":=", 
      RowBox[{
       RowBox[{"MTd", "[", 
        RowBox[{"d", ",", 
         RowBox[{"s", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"s", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], 
       SuperscriptBox[
        RowBox[{"Signature", "[", "s", "]"}], "P"]}]}], ";", 
     RowBox[{
      RowBox[{"g", "[", "S_", "]"}], ":=", 
      RowBox[{"Apply", "[", 
       RowBox[{"Times", ",", 
        RowBox[{"Map", "[", 
         RowBox[{"f", ",", 
          RowBox[{"Partition", "[", 
           RowBox[{"S", ",", "2"}], "]"}]}], "]"}]}], "]"}]}], ";", 
     RowBox[{"J1", "=", 
      RowBox[{"Map", "[", 
       RowBox[{"g", ",", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Permutations", "[", "intindices", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Signature", "[", "#", "]"}], "\[Equal]", "1"}], "&"}]}], 
         "]"}]}], "]"}]}], ";", 
     RowBox[{"J2", "=", 
      RowBox[{"Map", "[", 
       RowBox[{"g", ",", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Permutations", "[", "intindices", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Signature", "[", "#", "]"}], "\[Equal]", 
            RowBox[{"-", "1"}]}], "&"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"J3", "=", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"l", "/", "2"}], ")"}], "!"}], 
          SuperscriptBox["2", 
           RowBox[{"l", "/", "2"}]]}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Total", "[", "J1", "]"}], "+", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "P"], " ", 
           RowBox[{"Total", "[", "J2", "]"}]}]}], ")"}]}], "//", 
       "FullSimplify"}]}], ";", 
     RowBox[{"J3", "//.", 
      RowBox[{"Thread", "[", 
       RowBox[{"intindices", "\[Rule]", " ", "indices"}], "]"}]}]}]}], 
   "]"}]}]], "Input",
