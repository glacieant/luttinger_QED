Cell[CellGroupData[{

Cell["Longitudinal component of the vacuum polarization", "Subsection",
 CellChangeTimes->{{3.837082467156888*^9, 3.8370824891757812`*^9}, {
  3.8370825192696943`*^9, 
  3.837082525552681*^9}},ExpressionUUID->"ddc323c8-009d-4bed-a2ab-\
3b717fccfa2b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LongComp", "=", 
  RowBox[{
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"LFC", "[", 
      RowBox[{
       RowBox[{"Contract", "[", 
        RowBox[{"LI", " ", 
         RowBox[{"PL", "[", 
          RowBox[{"k", ",", "l", ",", "j"}], "]"}]}], "]"}], ",", "L", ",", 
       "LP", ",", 
       RowBox[{"d", "[", "k", "]"}], ",", 
       RowBox[{"{", "}"}]}], "]"}], ",", "q", ",", "FullSimplify"}], "]"}], "//",
    "TraditionalForm"}]}]], "Input",
 CellChangeTimes->{{3.8370824041219873`*^9, 3.8370824083133287`*^9}, {
  3.837082561528968*^9, 3.83708256184226*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"c218fbc4-208b-471c-883a-a0828c01a43f"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"d", "-", "4"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"d", "-", "2"}], ")"}], " ", 
      SuperscriptBox["e", "2"], " ", 
      SuperscriptBox["k", "2"], " ", 
      SuperscriptBox[
       FormBox[
        FormBox["k",
         TraditionalForm],
        TraditionalForm], 
       FormBox[
        FormBox["i",
         TraditionalForm],
        TraditionalForm]], " ", 
      SuperscriptBox[
       FormBox[
        FormBox["k",
         TraditionalForm],
        TraditionalForm], 
       FormBox[
        FormBox["j",
         TraditionalForm],
        TraditionalForm]]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"d", "+", "2"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"d", "+", "4"}], ")"}], " ", "m", " ", 
      SuperscriptBox["q", "4"]}]], "-", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"d", "-", "2"}], ")"}], " ", 
      SuperscriptBox["e", "2"], " ", 
      SuperscriptBox[
       FormBox[
        FormBox["k",
         TraditionalForm],
        TraditionalForm], 
       FormBox[
        FormBox["i",
         TraditionalForm],
        TraditionalForm]], " ", 
      SuperscriptBox[
       FormBox[
        FormBox["k",
         TraditionalForm],
        TraditionalForm], 
       FormBox[
        FormBox["j",
         TraditionalForm],
        TraditionalForm]]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"d", "+", "2"}], ")"}], " ", "m", " ", 
      SuperscriptBox["q", "2"]}]], "+", 
    FractionBox[
     RowBox[{"2", " ", 
      SuperscriptBox["e", "2"], " ", 
      SuperscriptBox[
       FormBox[
        FormBox["k",
         TraditionalForm],
        TraditionalForm], 
       FormBox[
        FormBox["i",
         TraditionalForm],
        TraditionalForm]], " ", 
      SuperscriptBox[
       FormBox[
        FormBox["k",
         TraditionalForm],
        TraditionalForm], 
       FormBox[
        FormBox["j",
         TraditionalForm],
        TraditionalForm]]}], 
     RowBox[{
      SuperscriptBox["k", "2"], " ", "m"}]]}],
   TraditionalForm],
  TraditionalForm,
