RuleDelayed::rhs : Pattern p_ appears on the right-hand side of rule \
LoopEvaluate[OBX_, w_, q_, arr_, L_, LP_, dfunc_, p0_, p_, \[Epsilon]_, \
extInd_, extGammaInd_] :> Module[{AX, BX, BX1, FreqPoles, FreqPosPoles, ResX, \
CX, CX1, DX, EX, FX, FX1, CFX, GX, GX1, HX, IX, JX, LX, KX, MX, NX, PX, QX, \
indexP, denomPW, feynprefact, TabTot, TabS, A, B, PreFactX, X, Y, x, y, z, i, \
j, k, l, lmax, n, r, s, s1, s2, arrsplit, a1, a2, a3, a4, b1, b2, b3, b4, c1, \
c2, c3, c4, redim, d1, d2, d3, d4, t, u, t1, t2, t3, t4, Lfunc, NewRule, \
RuleFunc, NewDRule, RuleDfunc, RuleDfunc2, feynintdom, C1, qFX, qFNORM}, AX = \
OBX //. {Pair[Momentum[L[i_, j_], D], Momentum[L[k_, l_], D]] -> MTd[i, k] \
MTd[j, l] + MTd[i, l] MTd[j, k] - - MTd[i, j] MTd[k, l], Pair[Momentum[L[i_, \
j_], D], Momentum[LP[k_, l_], D]] -> MTd[i, k] MTd[j, l] + MTd[i, l] MTd[j, \
k] + - MTd[i, j] MTd[k, l], Pair[Momentum[LP[i_, j_], D], Momentum[L[k_, l_], \
D]] -> MTd[i, k] MTd[j, l] + MTd[i, l] MTd[j, k] + - MTd[i, j] MTd[k, l], \
Pair[Momentum[LP[i_, j_], D], Momentum[LP[k_, l_], D]] -> MTd[i, k] MTd[j, l] \
+ MTd[i, l] MTd[j, k] - - MTd[i, j] MTd[k, l]}; BX = \
ExpandScalarProduct[Contract[AX //. {Pair[LorentzIndex[i_, d], \
LorentzIndex[j_, d]]   -> Pair[LorentzIndex[i, d], LorentzIndex[j, d]]}]]; \
BX1 = MomentumExpand[FullSimplify[BX /. {w -> z}]]; ResX[x_] := Residue[BX1, \
{z, x}]; FreqPoles = z /. Solve[Denominator[BX1] == 0, z]; FreqPosPoles = \
Assuming[Pair[Momentum[p, d], Momentum[q, d]] \[Element] Reals && p0 \
\[Element] Reals && Pair[Momentum[p, d], Momentum[p, d]] > 0 && \
Pair[Momentum[q, d], Momentum[q, d]] > 0 && Pair[Momentum[p, d], Momentum[p, \
d]] + 2 Pair[Momentum[p, d], Momentum[q, d]] + Pair[Momentum[q, d], \
Momentum[q, d]] > 0 && Pair[Momentum[p, d], Momentum[p, d]] - 2 \
Pair[Momentum[p, d], Momentum[q, d]] + Pair[Momentum[q, d], Momentum[q, d]] > \
0, Refine[FreqPoles HeavisideTheta /@ Im[FreqPoles]]]; CX = \
FullSimplify[Total[I ResX /@ FreqPosPoles], Assumptions -> {Pair[Momentum[p, \
d], Momentum[q, d]] \[Element] Reals, p0 \[Element] Reals, Pair[Momentum[p, \
d], Momentum[p, d]] > 0, Pair[Momentum[q, d], Momentum[q, d]] > 0, \
Pair[Momentum[p, d], Momentum[p, d]] + 2 Pair[Momentum[p, d], Momentum[q, d]] \
+ Pair[Momentum[q, d], Momentum[q, d]] > 0, Pair[Momentum[p, d], Momentum[p, \
d]] - 2 Pair[Momentum[p, d], Momentum[q, d]] + Pair[Momentum[q, d], \
Momentum[q, d]] > 0}]; DX = FullSimplify[Denominator[Combine[CX]]]; EX = \
FactorList[DX, Extension -> {Sqrt[2], I}]; n = Length[EX[[All,1]]]; FX = EX \
/. {Pair[Momentum[q, d], Momentum[q, d]] -> 0, Pair[Momentum[q, d], \
Momentum[p, d]] -> 0, Pair[Momentum[p, d], Momentum[q, d]] -> 0, \
Pair[Momentum[p, d], Momentum[p, d]] -> 0, p0 -> 0}; C1 = \
Product[If[TrueQ[FX[[i,1]] == 0], 1, Evaluate[FX[[i,1]]]], {i, 1, n}]; \
Do[If[TrueQ[FX[[i,1]] == 0], FX[[i,2]] = 0], {i, 1, n}]; FX1 = DeleteCases[EX \
- FX, {0, 0}]; indexP = FX1[[All,2]]; CFX = Collect[FX1[[All,1]], \
Pair[Momentum[q, d], Momentum[q, d]]]; r = Length[CFX]; \
Do[If[TrueQ[Exponent[CFX[[i]], Pair[Momentum[q, d], Momentum[q, d]]] > 2], \
Print[The computations failed because no feynman parametrization could be \
performed!]], {i, 1, r}]; qFX = CFX /. {(t_) Pair[Momentum[q, d], Momentum[q, \
d]] + (u_) -> Pair[Momentum[q, d], Momentum[q, d]] + -, (t_) Pair[Momentum[q, \
d], Momentum[q, d]] -> Pair[Momentum[q, d], Momentum[q, d]]}; qFNORM = Times \
@@ (CFX /. {(t_) Pair[Momentum[q, d], Momentum[q, d]] + (u_) -> t, (t_) \
Pair[Momentum[q, d], Momentum[q, d]] -> t, Pair[Momentum[q, d], Momentum[q, \
d]] + (u_) -> 1, Pair[Momentum[q, d], Momentum[q, d]] -> 1}); denomPW = \
Total[indexP]; feynprefact = ------------------------; TabS = Table[x[i], {i, \
1, r}]; TabTot = Total[TabS]; feynintdom = Table[{x[i], 0, 1}, {i, 1, r}]; GX \
= Collect2[Total[Table[TabS[[i]] qFX[[i]], {i, 1, r}]], Pair[Momentum[q, d], \
Momentum[q, d]], Factoring -> FullSimplify] /. {TabTot -> 1}; HX = \
Product[TabS[[i]]               , {i, 1, r}]; PreFactX = ----------- HX; A = \
Coefficient[GX, Pair[Momentum[q, d], Momentum[q, d]]]; B = Coefficient[GX, \
Pair[Momentum[p, d], Momentum[q, d]]]; IX = \
Simplify[ExpandScalarProduct[PreFactX Numerator[CX] /. {Momentum[q, d] -> \
Momentum[q, d] - --- Momentum[p, d]}]]; RuleFunc[t_] := Pair[LorentzIndex[t, \
d], Momentum[p, d]] :> arr[p, {t}]; NewRule = Join[{Pair[LorentzIndex[t_, d], \
Momentum[q, d]] :> arr[q, {t}], Pair[Momentum[p, d], Momentum[q, d]] :> \
arr[p, {a1}] arr[q, {a1}], Pair[Momentum[p, d], Momentum[q, d]]  :> arr[p, \
{a2, b2}] arr[q, {a2, b2}], Pair[Momentum[p, d], Momentum[q, d]]  :> arr[p, \
{a3, b3, c3}] arr[q, {a3, b3, c3}], Pair[Momentum[p, d], Momentum[q, d]]  :> \
arr[p, {a4, b4, c4, d4}] arr[q, {a4, b4, c4, d4}]}, Table[RuleFunc[t], {t, \
extInd}]]; JX = ExpandAll2[IX] //. NewRule; arrsplit[p_, s_] := Times @@ \
Table[FVd[p, i], {i, s}]; KX = JX //. {arr[q, s1_] arr[q, s2_] -> arr[q, \
Join[s1, s2]], arr[q, s_]  -> arr[q, Join[s, s]], arr[q, s_]  -> arr[q, \
Join[s, s, s, s]], arr[p, s1_] arr[p, s2_] -> arr[p, Join[s1, s2]], arr[p, \
s_]  -> arr[p, Join[s, s]], arr[p, s_]  -> arr[p, Join[s, s, s, s]]}; LX = KX \
//. {arr[q, s_] :> intcont[q, d, s]}; MX = LX //. {Pair[LorentzIndex[i_, d], \
LorentzIndex[j_, d]]   -> Pair[LorentzIndex[i, d], LorentzIndex[j, d]], L[i_, \
i_] :> 0, L[i_, j_] :> Lfunc[LorentzIndex[i, d], LorentzIndex[j, d]], arr[p, \
s_] :> arrsplit[p, s]}; RuleDfunc[t_] := Pair[LorentzIndex[t, D], \
Momentum[Lfunc[Momentum[p, d], Momentum[p, d]], D]] :> --------------- \
FVD[dfunc[p], t]; RuleDfunc2[t_] := Lfunc[LorentzIndex[i_, d], \
LorentzIndex[i_, d]] :> 0; NewDRule = Join[{Pair[Momentum[y_, d], \
Momentum[y_, d]] -> y }, Table[RuleDfunc[t], {t, extGammaInd}], \
Table[RuleDfunc2[t], {t, extGammaInd}]]; NX = ExpandAll2[Contract[MX] //. \
NewDRule]; GX1 = FullSimplify[ExpandScalarProduct[GX /. {Momentum[q, d] -> \
Momentum[q, d] - --- Momentum[p, d]}]] //. {Pair[Momentum[y_, d], \
Momentum[y_, d]] -> y }; X = Coefficient[GX1, q, 2]; Y = Coefficient[GX1, q, \
0]; redim = 4 - \[Epsilon]; lmax = Exponent[NX, q]; PX = Sum[Coefficient[NX, \
q, l] ifunc[X, Y, redim, denomPW, l], {l, 0, lmax}]; QX = \
FullSimplify[SeriesCoefficient[PX, {\[Epsilon], 0, -1}]] -; Integrate[QX \
DiracDelta[1 - TabTot], Evaluate[Sequence @@ feynintdom]]].
