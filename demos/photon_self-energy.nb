Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"\[CapitalOmega]", "[", "d", "]"}], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"2", "\[Pi]"}], ")"}], "d"]], 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox["q", 
      RowBox[{"d", "-", "1"}]], 
     SuperscriptBox["q", "l"], 
     RowBox[{"(", 
      FractionBox["1", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"X", " ", 
           SuperscriptBox["q", "2"]}], "+", "Y"}], ")"}], "n"]], ")"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"q", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"X", ">", "0"}], ",", 
       RowBox[{"Y", ">", "0"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"l", ",", "n", ",", "d"}], "}"}], "\[Element]", "Reals"}], ",", 
       RowBox[{"0", "\[LessEqual]", "l", "\[LessEqual]", " ", 
        RowBox[{"2", "n"}]}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8372653660132847`*^9, 3.837265367763596*^9}, {
