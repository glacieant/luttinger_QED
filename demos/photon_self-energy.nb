Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["2", 
    RowBox[{
     RowBox[{"-", "7"}], "-", "d"}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "8"}], "+", "d", "+", "l"}], ")"}], " ", 
   RowBox[{"(", 
