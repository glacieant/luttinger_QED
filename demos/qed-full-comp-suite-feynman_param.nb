Cell[BoxData[
 RowBox[{
  RowBox[{"intcont", "[", 
   RowBox[{"q_", ",", "d_", ",", "indices_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"l", "=", 
       RowBox[{"Length", "[", "indices", "]"}]}], ",", "norm"}], "}"}], ",", 
    RowBox[{
     RowBox[{"norm", "=", 
