          RowBox[{"Pair", "[", 
           RowBox[{
            RowBox[{"Momentum", "[", 
             RowBox[{"q", ",", "d"}], "]"}], ",", 
            RowBox[{"Momentum", "[", 
             RowBox[{"q", ",", "d"}], "]"}]}], "]"}], 
          FractionBox["l", "2"]], 
         RowBox[{"wick", "[", 
          RowBox[{"indices", ",", "0"}], "]"}]}], ",", "0"}], "]"}], "//", 
      "FullSimplify"}]}]}], "]"}]}]], "Input",
