Cell[BoxData[
 RowBox[{
  RowBox[{"ifunc", "[", 
   RowBox[{"X_", ",", "Y_", ",", "d_", ",", "n_", ",", "l_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{
    SuperscriptBox["2", 
     RowBox[{"-", "d"}]], " ", 
    SuperscriptBox["\[Pi]", 
     RowBox[{
      RowBox[{"-", "d"}], "/", "2"}]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["X", "Y"], ")"}], 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "d"}], "-", "l"}], ")"}]}]], " ", 
    SuperscriptBox["Y", 
     RowBox[{"-", "n"}]], " ", 
    RowBox[{"Gamma", "[", 
     FractionBox[
      RowBox[{"d", "+", "l"}], "2"], "]"}], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["d", "2"]}], "-", 
      FractionBox["l", "2"], "+", "n"}], "]"}]}], 
   RowBox[{
    RowBox[{"Gamma", "[", 
     FractionBox["d", "2"], "]"}], " ", 
    RowBox[{"Gamma", "[", "n", "]"}]}]]}]], "Input",
