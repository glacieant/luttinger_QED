Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalOmega]", "[", "d_", "]"}], ":=", 
  FractionBox[
   RowBox[{"2", 
    SuperscriptBox["\[Pi]", 
     RowBox[{"d", "/", "2"}]]}], 
   RowBox[{"Gamma", "[", 
    RowBox[{"d", "/", "2"}], "]"}]]}]], "Input",
