       RowBox[{
        RowBox[{"Pochhammer", "[", 
         RowBox[{
          FractionBox["d", "2"], ",", 
          FractionBox["l", "2"]}], "]"}], 
        SuperscriptBox["2", 
         FractionBox["l", "2"]]}]]}], ";", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"EvenQ", "[", "l", "]"}], ",", 
        RowBox[{"norm", " ", 
         SuperscriptBox["q", "l"], 
         RowBox[{"wick", "[", 
          RowBox[{"indices", ",", "0"}], "]"}]}], ",", "0"}], "]"}], "//", 
      "FullSimplify"}]}]}], "]"}]}]], "Input",
