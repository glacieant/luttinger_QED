Cell[BoxData[
 RowBox[{
  RowBox[{"FreeEnDensity", "[", 
   RowBox[{"klim_", ",", "B_", ",", "g_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"kx", ",", "ky", ",", "kz", ",", 
      RowBox[{"Hx", "=", 
       RowBox[{"B", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"Hy", "=", 
       RowBox[{"B", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", 
      RowBox[{"Hz", "=", 
       RowBox[{"B", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"2", "\[Pi]"}], ")"}], "3"]], 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"EigS", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"kx", ",", "ky", ",", "kz"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"Hx", ",", "Hy", ",", "Hz"}], "}"}], ",", "g"}], "]"}], ".", 
         RowBox[{"Map", "[", 
          RowBox[{"Fermi", ",", 
           RowBox[{"EigS", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"kx", ",", "ky", ",", "kz"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"Hx", ",", "Hy", ",", "Hz"}], "}"}], ",", "g"}], 
            "]"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"kx", ",", 
          RowBox[{"-", "klim"}], ",", "klim"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"ky", ",", 
          RowBox[{"-", "klim"}], ",", "klim"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"kz", ",", 
          RowBox[{"-", "klim"}], ",", "klim"}], "}"}]}], "]"}]}], "+", 
     FractionBox[
      RowBox[{"B", ".", "B"}], "2"]}]}], "]"}]}]], "Input",
